# Supabase public project settings (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key is also accepted by the client helper if your project shows that instead.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Paystack test keys — secret key is server-side only
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Resend email delivery — server-side only
RESEND_API_KEY=
SNAPSTUDIO_FROM_EMAIL=

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
